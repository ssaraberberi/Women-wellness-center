# Copy to backend/.env for local work. On Railway every one of these is a
# service variable — never commit real values.

# development | production. "development" enables the dev-account login code below.
APP_ENV=development
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Railway Postgres injects DATABASE_URL (reference it as ${{Postgres.DATABASE_URL}}).
# Locally: `npm run dev:db` prints this.
DATABASE_URL=postgresql://dua:dua@localhost:5433/dua_app

# Two independent 32+ character random secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-0000000000
OTP_PEPPER=change-me-to-another-long-random-string-000000

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------- email (Resend) ----------
# Without a key nothing is emailed; the OTP is written to the server log instead
# (development only — production refuses to start without a key).
RESEND_API_KEY=
MAIL_FROM=DUA Pilates & SPA <no-reply@dua-pilates.com>

# ---------- development accounts ----------
# Only when APP_ENV=development: the seeded @dua.dev accounts accept this fixed
# code, so Admin / Staff / Client can be tried on a phone without an inbox.
# Leave empty to require real emailed codes for everyone.
DEV_LOGIN_CODE=000000

# ---------- background jobs ----------
# true: this process also runs the worker loop (one Railway service is enough).
# false: run `npm run worker` as a separate Railway service.
RUN_WORKER=true

# Comma-separated origins allowed by CORS (the native app does not need CORS;
# this is for the web build / docs). Empty = none.
CORS_ORIGINS=

# ---------- online payments ----------
# none | (future provider id). With "none", payments are recorded at the desk.
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=
