# Copy to .env for local work. Railway sets DATABASE_URL and PORT itself
# once a Postgres service is attached — do not paste those in by hand there.

# Postgres. Locally this is your own instance; on Railway use the
# variable reference ${{ Postgres.DATABASE_URL }} so it follows the service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dua

# The code someone must type to create an administrator account.
# Read only by the server, stored in the settings table by the seed.
# Change it before you go live.
ADMIN_REGISTRATION_CODE=DUA-2026-STUDIO

# Password given to every demo account the seed creates.
SEED_PASSWORD=demo1234

# Set in production so the session cookie is marked Secure.
NODE_ENV=development

# Port. Railway injects its own; this is only for local runs.
PORT=3000

# TLS to Postgres: 'on' to force, 'off' to disable. Left unset, the
# server turns it on for Railway's public proxy and off for a local socket.
# PGSSL=on
