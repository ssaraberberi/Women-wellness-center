# Copy to .env for local work. On Vercel these come from the project's
# Environment Variables, and DATABASE_URL arrives with the Postgres
# integration — do not paste it in by hand there.

# Postgres. Locally this is your own instance; on Vercel the Neon
# integration sets it. Use the provider's POOLED endpoint: a function is
# one request at a time and will otherwise run the database out of
# connections.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dua

# The administrator registration code is NOT here. It lives in
# scripts/data.sql, because that is the file that writes it to the
# database, and the server reads it from there.

# Password given to every demo account `npm run seed:demo` creates.
SEED_PASSWORD=demo1234

# Set in production so the session cookie is marked Secure. On Vercel this
# is implied: the function sets Secure whenever VERCEL is present.
NODE_ENV=development

# Port for `npm start` locally. Vercel does not use it.
PORT=3000

# TLS to Postgres: 'on' to force, 'off' to disable. Left unset, it is on
# for every host but localhost.
# PGSSL=on
