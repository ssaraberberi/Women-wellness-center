# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by prebuild / EAS — never edited by hand)
/ios
/android
.kotlin/
*.orig.*

# Signing credentials: managed by EAS, never committed
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# Environment: only the example is committed
.env
.env.*
!.env.example

# Maestro run artefacts
.maestro/artifacts/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# typescript
*.tsbuildinfo
