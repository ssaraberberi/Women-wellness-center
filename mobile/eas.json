{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_API_URL": "https://api-development-7dd9.up.railway.app" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api-development-7dd9.up.railway.app" }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://api-prod-production-19a0.up.railway.app" }
    }
  },
  "submit": {
    "production": {}
  }
}
