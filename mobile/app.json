{
  "expo": {
    "name": "DUA",
    "slug": "dua-pilates-spa",
    "owner": "sberberiiiii",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dua",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3ECE4",
    "ios": {
      "bundleIdentifier": "com.duapilatesandspa.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "DUA adds your booked classes and SPA appointments to your calendar when you ask it to.",
        "NSCalendarsFullAccessUsageDescription": "DUA adds your booked classes and SPA appointments to your calendar when you ask it to.",
        "NSRemindersUsageDescription": "DUA does not use reminders.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.duapilatesandspa.app",
      "adaptiveIcon": {
        "backgroundColor": "#5E1F2D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3ECE4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#5E1F2D"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "DUA adds your booked classes and SPA appointments to your calendar when you ask it to."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "85e80d17-bf90-4ad0-b002-17b6e663e795"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
